---
// Weekly active customer organisations, production. First 33 days of telemetry.
// Partial weeks are marked, and the fall after the peak is shown, not hidden.
const weeks = [
  { w: '10 Aug', v: 25, partial: true },
  { w: '17 Aug', v: 45 },
  { w: '24 Aug', v: 58 },
  { w: '31 Aug', v: 115, peak: true },
  { w: '7 Sep', v: 88 },
];
const max = 120;
---

<figure class="chart" aria-labelledby="wk-cap">
  <div class="bars" role="img" aria-label="Weekly active organisations: 25, 45, 58, 115 at the peak, then 88.">
    {
      weeks.map((d) => (
        <div class="col" style={`--h:${(d.v / max) * 100}%`}>
          <span class="v">{d.v}</span>
          <span class:list={['bar', { peak: d.peak, partial: d.partial }]} />
          <span class="w label">{d.w}{d.partial ? '*' : ''}</span>
        </div>
      ))
    }
  </div>
  <figcaption id="wk-cap" class="label">
    Weekly active customer organisations, production. *Partial week, tracking began 12 August.
  </figcaption>
</figure>

<style>
  .chart {
    margin-block: 1.8em;
    padding: 22px 22px 16px;
    border: 1px solid var(--ink);
    background: var(--paper-lift);
  }
  .bars {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(10px, 2vw, 22px);
    height: 220px;
    align-items: end;
    border-bottom: 1px solid var(--ink);
  }
  .col {
    position: relative;
    height: 100%;
    display: flex;
    align-items: flex-end;
  }
  .v {
    font-stretch: 125%;
    font-weight: 860;
    font-size: 15px;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    position: absolute;
    left: 0;
    bottom: calc(var(--h) + 6px);
  }
  .bar {
    display: block;
    width: 100%;
    height: var(--h);
    background: var(--ink);
    transform-origin: bottom;
  }
  .bar.partial { background: repeating-linear-gradient(135deg, var(--ink) 0 2px, transparent 2px 6px); outline: 1px solid var(--ink); outline-offset: -1px; }
  .bar.peak { background: var(--flash); outline: 1px solid var(--ink); outline-offset: -1px; }
  .w { position: absolute; top: calc(100% + 8px); left: 0; }
  figcaption { margin-top: 40px; }
</style>
