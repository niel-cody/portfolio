---
// The template every playground follows: what it does, the thing itself, how it
// works, the decisions and why, build your own, a colophon, and an honest status.
import Base, { type Flash } from '../layouts/Base.astro';
import SectionHead from './SectionHead.astro';
import Sticker from './Sticker.astro';
import Status from './Status.astro';

interface Props {
  title: string;
  number: string;
  era: string;
  flash: Flash;
  lede: string;
  description: string;
  howto: string;
  status: string;
  what: { headline: string; body: string[] };
  how: [string, string][];
  decisions: [string, string][];
  build: string[];
  colophon: [string, string][];
  sticker: string;
}
const p = Astro.props;
---

<Base title={p.title} description={p.description} flash={p.flash} section="playground" image={`/cards/${p.title.toLowerCase()}.png`}>
  <section class="wrap intro">
    <nav class="crumbs label" aria-label="Breadcrumb">
      <a href="/playground/">Playground</a><span aria-hidden="true">/</span><span>No. {p.number}</span>
      <span class="era">{p.era}</span>
    </nav>
    <div class="title-row">
      <h1 class="display display-xxl">{p.title}</h1>
      <Sticker class="pg-sticker" ring={`${p.sticker} ✶ ${p.era} ✶ `} center={p.number} />
    </div>
    <div class="grid sub">
      <p class="lede">{p.lede}</p>
      <div class="pills">
        <Status label={p.status} live />
        <Status label="No model calls" ghost />
      </div>
    </div>
  </section>

  <section class="wrap stage" aria-label={`${p.title}, interactive`}>
    <p class="label howto">{p.howto}</p>
    <slot />
  </section>

  <section class="wrap block">
    <SectionHead n="01" title="What it does" aside="And why it exists" />
    <div class="grid two">
      <p class="display display-m">{p.what.headline}</p>
      <div class="prose">{p.what.body.map((b) => <p set:html={b} />)}</div>
    </div>
  </section>

  <section class="wrap block">
    <SectionHead n="02" title="How it works" aside="No black boxes" />
    <ol class="steps">
      {
        p.how.map(([t, d], i) => (
          <li class="reveal">
            <span class="num sn">{i + 1}</span>
            <span class="st">{t}</span>
            <span class="sd">{d}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap block">
    <SectionHead n="03" title="Decisions made, and why" aside="Written down so they can be wrong" />
    <ol class="dec-list">
      {
        p.decisions.map(([t, d], i) => (
          <li class="reveal">
            <span class="label label-ink">{String(i + 1).padStart(2, '0')}</span>
            <span class="dt">{t}</span>
            <span class="dd">{d}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap block">
    <SectionHead n="04" title="Build your own" aside="An afternoon" />
    <div class="prose build">
      <ol>{p.build.map((b) => <li set:html={b} />)}</ol>
    </div>
  </section>

  <section class="wrap block">
    <SectionHead n="05" title="Colophon" aside="What it is made of" />
    <dl class="colophon">
      {
        p.colophon.map(([k, v]) => (
          <div>
            <dt class="label label-ink">{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
    <div class="status-row">
      <Status label={`Status: ${p.status.toLowerCase()}, September 2026`} live />
      <a class="go" href="/playground/">All playgrounds <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>

<style>
  .intro { padding-top: clamp(28px, 4vw, 48px); }
  .crumbs { display: flex; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid var(--ink); }
  .crumbs a { color: var(--ink); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .era { margin-left: auto; }
  .title-row { position: relative; margin-top: clamp(20px, 3vw, 40px); }
  :global(.pg-sticker) { right: 0; top: -10px; }
  @media (max-width: 700px) { :global(.pg-sticker) { display: none; } }
  .sub { margin-top: 28px; row-gap: 20px; align-items: end; }
  .sub .lede { grid-column: 1 / span 7; max-width: 48ch; }
  .pills { grid-column: 9 / span 4; display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  @media (max-width: 900px) { .sub .lede, .pills { grid-column: 1 / -1; justify-content: flex-start; } }

  .stage { margin-top: clamp(40px, 6vw, 72px); display: grid; gap: 16px; }
  .howto { color: var(--ink); }

  .block { padding-top: clamp(72px, 10vw, 140px); }
  .two { margin-top: 28px; row-gap: 32px; align-items: start; }
  .two > :first-child { grid-column: 1 / span 5; max-width: 16ch; }
  .two > :last-child { grid-column: 7 / span 6; }
  @media (max-width: 900px) { .two > * { grid-column: 1 / -1 !important; } }

  .steps { list-style: none; padding: 0; margin-top: 28px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: 1px solid var(--ink); }
  .steps li { display: grid; align-content: start; gap: 10px; padding: 20px; }
  .steps li + li { border-left: 1px solid var(--ink); }
  .sn { font-size: 52px; }
  .st { font-stretch: 115%; font-weight: 760; font-size: 18px; letter-spacing: -0.015em; line-height: 1.2; }
  .sd { font-size: 14.5px; line-height: 1.5; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; }
    .steps li + li { border-left: 0; border-top: 1px solid var(--ink); }
  }

  .dec-list { list-style: none; padding: 0; margin-top: 8px; }
  .dec-list li { display: grid; grid-template-columns: 56px minmax(0, 5fr) minmax(0, 6fr); gap: 24px; padding: 22px 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .dt { font-stretch: 115%; font-weight: 760; font-size: 19px; letter-spacing: -0.015em; line-height: 1.2; }
  .dd { font-size: 16px; line-height: 1.5; }
  @media (max-width: 860px) { .dec-list li { grid-template-columns: 40px 1fr; } .dd { grid-column: 2; } }

  .build { margin-top: 28px; }

  .colophon { margin-top: 12px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; }
  .colophon div { display: grid; grid-template-columns: 120px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .colophon dd { font-size: 15.5px; line-height: 1.45; }
  @media (max-width: 860px) { .colophon { grid-template-columns: 1fr; } }
  .status-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-top: 28px; }
</style>
