---
interface Props {
  ring: string;
  center: string;
  class?: string;
  style?: string;
}
const { ring, center, class: cls, style } = Astro.props;
const id = `ring-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['sticker', cls]} style={style} aria-hidden="true">
  <svg viewBox="0 0 100 100">
    <defs>
      <path id={id} d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" />
    </defs>
    <text><textPath href={`#${id}`}>{ring}</textPath></text>
  </svg>
  <b>{center}</b>
</div>
