---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import mono from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';

export type Flash = 'orange' | 'acid' | 'cobalt' | 'bubblegum' | 'butter';

interface Props {
  title?: string;
  description?: string;
  flash?: Flash;
  section?: 'home' | 'work' | 'playground' | 'writing' | 'about' | 'colophon';
  image?: string;
}

const {
  title,
  description = 'Niel Cody builds hospitality software that holds up on a Friday night. Product leader: AI in production, platforms, loyalty, and eight years on the floor before any of it.',
  flash = 'orange',
  section = 'home',
  image = '/cards/home.png',
} = Astro.props;

const fullTitle = title ? `${title} — Niel Cody` : 'Niel Cody — Product that holds on a Friday night';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f1efea" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Niel Cody" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <style is:global>
      @view-transition { navigation: auto; }
      ::view-transition-old(root) { animation: 160ms cubic-bezier(0.2, 0.7, 0.2, 1) both vt-out; }
      ::view-transition-new(root) { animation: 260ms cubic-bezier(0.2, 0.7, 0.2, 1) both vt-in; }
      @keyframes vt-out { to { opacity: 0; } }
      @keyframes vt-in { from { opacity: 0; translate: 0 8px; } }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
      }
    </style>
    <slot name="head" />
  </head>
  <body data-flash={flash} data-section={section}>
    <a class="skip" href="#main">Skip to content</a>
    <Header section={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <div class="grid-overlay" aria-hidden="true">
      <div class="wrap"><div class="grid">{Array.from({ length: 12 }).map(() => <span />)}</div></div>
    </div>

    <script>
      // Reveal on scroll. Progressive: content is visible without it.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // G shows the grid, like the back page of a product manual.
      addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === 'g' || e.key === 'G') document.documentElement.classList.toggle('show-grid');
      });
    </script>
  </body>
</html>
